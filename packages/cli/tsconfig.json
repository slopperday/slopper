{
  // The CLI runs on plain Node, unlike the app: Node's module rules, no DOM.
  "include": ["src", "tests", "vite.config.ts"],
  "compilerOptions": {
    "lib": ["ES2024"],
    "types": ["node"],
    "target": "ES2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "noFallthroughCasesInSwitch": true
  }
}
