# Copy to .env.local for local development. `convex dev` and
# `node scripts/convex-keys.ts` fill in the Convex lines for you.

# Public origin used for OAuth redirects and absolute links.
APP_URL=http://localhost:5173

# Convex: deployment URL (written by `convex dev` as VITE_CONVEX_URL locally).
CONVEX_URL=
# JWTs the app signs and Convex trusts. Generate with: node scripts/convex-keys.ts
SLOPPER_JWT_ISSUER=http://localhost:5173
SLOPPER_JWT_PRIVATE_KEY=

# Encrypts connected social accounts' tokens. Generate: openssl rand -base64 32
SLOPPER_SECRET_KEY=

# Lower-case usernames allowed to moderate, comma separated.
ADMIN_USERNAMES=

# Sign in (optional locally; the dev login works without them). Each
# provider's button shows only when both of its keys are set. X and LinkedIn
# (below) sign people in too.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Facebook Login: the app's App ID and App Secret.
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Content check for launches, updates and screenshots (DeepSeek). Nothing is
# auto-posted until a slop passes it, so set this before connecting accounts.
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Screenshots in a Backblaze B2 bucket (optional; without them, Convex file
# storage). Set all five or none. The key needs writeFiles and deleteFiles on
# that one bucket. Images are served from MEDIA_PUBLIC_URL, which lives on
# Convex because Convex builds image URLs:
#   npx convex env set MEDIA_PUBLIC_URL https://f004.backblazeb2.com/file/<bucket>
B2_ENDPOINT=
B2_REGION=
B2_BUCKET=
B2_KEY_ID=
B2_APPLICATION_KEY=

# Sign in and auto-posting (optional). One app each serves both, through the
# same callback URL. X posting is billed per post by X.
X_CLIENT_ID=
X_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Feedback and kudos on slops. Off for V1 (unset); "true" turns them on.
# COMMENTS_ENABLED=true
