# Copy to .env.local for local development. Production is declared in
# monosecret.toml and set on Netlify with `vp run env:netlify`. `convex dev` and
# `node scripts/convex-keys.ts` fill in the Convex lines for you.

# Public origin used for OAuth redirects and absolute links.
APP_URL=http://localhost:5173

# Convex: deployment URL (written by `convex dev` as VITE_CONVEX_URL locally).
CONVEX_URL=
# Where browsers send analytics: the deployment's HTTP actions. Worked out from a
# cloud CONVEX_URL (.convex.cloud -> .convex.site); a local backend needs it set
# (its site port, usually http://127.0.0.1:3211). Unset there: analytics stays off.
# CONVEX_SITE_URL=
# JWTs the app signs and Convex trusts. Generate with: node scripts/convex-keys.ts
SLOPPER_JWT_ISSUER=http://localhost:5173
SLOPPER_JWT_PRIVATE_KEY=

# Encrypts connected social accounts' tokens. Generate: openssl rand -base64 32
SLOPPER_SECRET_KEY=

# Sign-in accounts that are always admins, comma separated, as provider:id
# (github:1160934; locally, dev:<username> for the dev login). Whoever signs in
# with one becomes an admin. Admins make other people moderators or admins at
# /mod/team.
ADMIN_IDENTITIES=

# Sign in (optional locally; the dev login works without them). Each
# provider's button shows only when both of its keys are set. X and LinkedIn
# (below) sign people in too.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Facebook Login: the app's App ID and App Secret.
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Content check for launches, updates and screenshots, through OpenRouter. Nothing
# is auto-posted until a slop passes it, so set this before connecting accounts.
OPENROUTER_API_KEY=
# Any OpenRouter model that reads images and supports JSON mode.
# OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash
# The provider tried first; others take over when it's down.
# OPENROUTER_PROVIDER=deepseek
# Trusted makers' promo videos, with the same key and policy: a model that
# watches video (sent inline) and supports JSON mode with reasoning off.
# OPENROUTER_VIDEO_MODEL=google/gemini-3.1-flash-lite
# OPENROUTER_VIDEO_PROVIDER=google-ai-studio

# Browser notifications (optional). The public half of the VAPID key pair;
# `vp run vapid` writes it here and puts both halves on Convex.
VAPID_PUBLIC_KEY=

# Screenshots in a Backblaze B2 bucket (optional; without them, Convex file
# storage). Set all five or none. The key needs writeFiles and deleteFiles on
# that one bucket. Images are served from MEDIA_PUBLIC_URL, which lives on
# Convex because Convex builds image URLs:
#   npx convex env set MEDIA_PUBLIC_URL https://f004.backblazeb2.com/file/<bucket>
B2_ENDPOINT=
B2_REGION=
B2_BUCKET=
B2_KEY_ID=
B2_APPLICATION_KEY=

# Sign in and auto-posting (optional). One app each serves both, through the
# same callback URL. X posting is billed per post by X.
X_CLIENT_ID=
X_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Feedback and kudos on slops. Off for V1 (unset); "true" turns them on.
# COMMENTS_ENABLED=true
